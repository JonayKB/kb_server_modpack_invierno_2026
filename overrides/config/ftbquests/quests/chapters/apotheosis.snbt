	quests: [
		{
			description: [
				"&aEterna&r acts as a modifier to the enchanting level, increasing the base \"level\" of enchantments beyond the vanilla cap of 30, allowing access to higher levels (up to 100) for enchants like Looting and Fortune."
				"{image:fzzy_config:textures/gui/sprites/widget/popup/divider.png width:200 height:15 align:center"
				"&cQuanta&r represents the randomness or variance in the enchanting process; after selecting an enchant, Quanta can raise or lower its level, offering a chance to achieve levels higher than normally possible, though it risks lower outcomes. "
				"{image:fzzy_config:textures/gui/sprites/widget/popup/divider.png width:200 height:15 align:center"
				"&dArcana&r modifies the probability of obtaining rare versus common enchantments.  At 0%, rare enchants are impossible; at high levels, common enchants become impossible."
			]
			icon: {
				Count: 1
				id: "minecraft:enchanted_book"
